{
  "name": "@society/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @society/config build && pnpm --filter @society/contracts build",
    "dev": "nest start --watch --preserveWatchOutput",
    "prebuild": "pnpm --filter @society/config build && pnpm --filter @society/contracts build",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @society/config build && pnpm --filter @society/contracts build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.6.3",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.3",
    "@nestjs/platform-express": "12.6.3",
    "@nestjs/swagger": "12.1.3",
    "@society/config": "workspace:*",
    "@society/contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.3",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15"
  }
}
